{
  "name": "@dashkite/domo",
  "version": "0.2.29",
  "description": "HTML-as-code in plain CoffeeScript or JavaScript",
  "files": [
    "build/browser/src",
    "build/node/src"
  ],
  "exports": {
    ".": {
      "browser": "./build/browser/src/index.js",
      "node": "./build/node/src/index.js"
    },
    "./*": {
      "browser": "./build/browser/src/*.js",
      "node": "./build/node/src/*.js"
    }
  },
  "scripts": {
    "test": "genie test",
    "build": "genie build",
    "release": "genie release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dashkite/domo.git"
  },
  "keywords": [
    "vdom",
    "html",
    "templates"
  ],
  "author": "Dan Yoder",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dashkite/domo/issues"
  },
  "homepage": "https://github.com/dashkite/domo#readme",
  "dependencies": {
    "@dashkite/generic": "^0.9.27",
    "@dashkite/joy": "^0.11.0"
  },
  "devDependencies": {
    "@dashkite/genie": "^0.20.22",
    "@dashkite/genie-clean": "^0.13.22",
    "@dashkite/genie-coffee": "^0.13.24",
    "@dashkite/genie-module": "^0.5.52",
    "@dashkite/genie-release": "^0.5.12"
  }
}
